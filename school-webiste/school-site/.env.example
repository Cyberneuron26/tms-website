# Copy to .env.local. Do not commit production credentials.
GOOGLE_SPREADSHEET_ID=
GOOGLE_CLIENT_EMAIL=
# Paste escaped newlines using \n in this value
GOOGLE_PRIVATE_KEY=
REVALIDATE_SECRET=replace-with-a-long-random-secret
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Leave true for preview/demo mode; set false in production with real Sheets
DEMO_MODE=true
